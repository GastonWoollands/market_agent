# Copy to .env and fill in keys. Never commit .env.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://market:market@localhost:5433/market_agent

# Required for later days — leave blank until that day's ingest
FRED_API_KEY=
FINNHUB_API_KEY=
ANTHROPIC_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with a real contact email
SEC_USER_AGENT=MarketAgent you@email.com

# Optional. Comma-separated browser origins for the Next.js UI.
CORS_ORIGINS=http://localhost:3000

# Optional quote fallback (Day 2+)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
